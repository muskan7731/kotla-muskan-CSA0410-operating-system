#include <stdio.h>

struct Process
{
    int pid;
    int bt;      // Burst Time
    int priority;
    int wt;      // Waiting Time
    int tat;     // Turnaround Time
};

int main()
{
    int n, i, j;
    struct Process p[20], temp;
    float totalWT = 0, totalTAT = 0;

    printf("========================================\n");
    printf("     PRIORITY SCHEDULING ALGORITHM\n");
    printf("========================================\n");

    printf("Enter the number of processes: ");
    scanf("%d", &n);

    printf("\nEnter Burst Time and Priority for each process\n");
    printf("(Smaller Priority Number = Higher Priority)\n\n");

    for(i = 0; i < n; i++)
    {
        p[i].pid = i + 1;

        printf("Process P%d\n", p[i].pid);

        printf("Burst Time : ");
        scanf("%d", &p[i].bt);

        printf("Priority   : ");
        scanf("%d", &p[i].priority);

        printf("\n");
    }

    // Sort according to Priority
    for(i = 0; i < n - 1; i++)
    {
        for(j = i + 1; j < n; j++)
        {
            if(p[i].priority > p[j].priority)
            {
                temp = p[i];
                p[i] = p[j];
                p[j] = temp;
            }
        }
    }

    // Calculate Waiting Time
    p[0].wt = 0;

    for(i = 1; i < n; i++)
    {
        p[i].wt = p[i-1].wt + p[i-1].bt;
    }

    // Calculate Turnaround Time
    for(i = 0; i < n; i++)
    {
        p[i].tat = p[i].wt + p[i].bt;

        totalWT += p[i].wt;
        totalTAT += p[i].tat;
    }

    printf("\n---------------------------------------------------------------\n");
    printf("PID\tPriority\tBurst Time\tWaiting Time\tTurnaround Time\n");
    printf("---------------------------------------------------------------\n");

    for(i = 0; i < n; i++)
    {
        printf("P%d\t%d\t\t%d\t\t%d\t\t%d\n",
               p[i].pid,
               p[i].priority,
               p[i].bt,
               p[i].wt,
               p[i].tat);
    }

    printf("---------------------------------------------------------------\n");

    printf("\nAverage Waiting Time     = %.2f", totalWT / n);
    printf("\nAverage Turnaround Time  = %.2f\n", totalTAT / n);

    // Gantt Chart
    printf("\nGantt Chart\n");
    printf("------------\n|");

    for(i = 0; i < n; i++)
    {
        printf(" P%d |", p[i].pid);
    }

    printf("\n0");

    int time = 0;

    for(i = 0; i < n; i++)
    {
        time += p[i].bt;
        printf("\t%d", time);
    }

    printf("\n");

    return 0;
}

