#include <stdio.h>
#include <pthread.h>

void *threadFunction(void *arg)
{
    printf("Hello from Thread!\n");
    return NULL;
}

int main()
{
    pthread_t thread;

    pthread_create(&thread, NULL, threadFunction, NULL);

    pthread_join(thread, NULL);

    printf("Thread Execution Completed.\n");

    return 0;
}
OUTPUT
Hello from Thread!
Thread Execution Completed.
