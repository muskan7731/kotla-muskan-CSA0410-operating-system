#include <stdio.h>

int main()
{
    int n, start, i;

    printf("Enter starting block: ");
    scanf("%d", &start);

    printf("Enter number of blocks: ");
    scanf("%d", &n);

    printf("\nSequential File Allocation\n");

    for(i = 0; i < n; i++)
    {
        printf("Block %d --> File Block %d\n", start + i, i + 1);
    }

    return 0;
}
