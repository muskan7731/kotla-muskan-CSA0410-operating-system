#include <stdio.h>

int main()
{
    FILE *fp;
    char data[100];

    fp = fopen("sample.txt", "w");
    fprintf(fp, "Operating System Lab");
    fclose(fp);

    fp = fopen("sample.txt", "r");
    fgets(data, sizeof(data), fp);
    fclose(fp);

    printf("File Content: %s\n", data);

    remove("sample.txt");
    printf("File Deleted Successfully.\n");

    return 0;
}
