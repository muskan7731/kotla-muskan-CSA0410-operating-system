#include <stdio.h>

int main()
{
    int block[5]={100,500,200,300,600};
    int process[4]={212,417,112,426};

    int i,j,index;

    printf("Process\tBlock\n");

    for(i=0;i<4;i++)
    {
        index=-1;

        for(j=0;j<5;j++)
        {
            if(block[j]>=process[i])
            {
                if(index==-1 || block[j]>block[index])
                    index=j;
            }
        }

        if(index!=-1)
        {
            printf("%d\t%d\n",process[i],index+1);
            block[index]-=process[i];
        }
        else
            printf("%d\tNot Allocated\n",process[i]);
    }

    return 0;
}
output 
