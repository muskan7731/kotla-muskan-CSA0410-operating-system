#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main()
{
    int fd;

    fd = open("sample.txt", O_CREAT | O_WRONLY, 0644);

    write(fd, "Operating System", 16);

    close(fd);

    printf("File Created and Data Written Successfully.\n");

    return 0;
}
OUTPUT
File Created and Data Written Successfully.
