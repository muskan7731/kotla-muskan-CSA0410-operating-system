#include <stdio.h>

int main()
{
    int n, index, block[20], i;

    printf("Enter Index Block: ");
    scanf("%d", &index);

    printf("Enter number of file blocks: ");
    scanf("%d", &n);

    printf("Enter block numbers:\n");

    for(i = 0; i < n; i++)
        scanf("%d", &block[i]);

    printf("\nIndex Block = %d\n", index);

    printf("File Allocation\n");

    for(i = 0; i < n; i++)
        printf("Entry %d --> Block %d\n", i + 1, block[i]);

    return 0;
}
