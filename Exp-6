#include <stdio.h>

int main()
{
    int n, i, time = 0, completed = 0;
    int bt[10], rt[10], pr[10], wt[10], tat[10];
    int min, highest;

    float avgWT = 0, avgTAT = 0;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++)
    {
        printf("\nProcess P%d\n", i + 1);

        printf("Burst Time: ");
        scanf("%d", &bt[i]);

        printf("Priority (Lower number = Higher priority): ");
        scanf("%d", &pr[i]);

        rt[i] = bt[i];
    }

    while(completed != n)
    {
        min = 9999;
        highest = -1;

        for(i = 0; i < n; i++)
        {
            if(rt[i] > 0 && pr[i] < min)
            {
                min = pr[i];
                highest = i;
            }
        }

        rt[highest]--;
        time++;

        if(rt[highest] == 0)
        {
            completed++;

            tat[highest] = time;
            wt[highest] = tat[highest] - bt[highest];

            avgWT += wt[highest];
            avgTAT += tat[highest];
        }
    }

    printf("\nPID\tBT\tPriority\tWT\tTAT\n");

    for(i = 0; i < n; i++)
    {
        printf("P%d\t%d\t%d\t\t%d\t%d\n",
               i + 1, bt[i], pr[i], wt[i], tat[i]);
    }

    printf("\nAverage Waiting Time = %.2f", avgWT / n);
    printf("\nAverage Turnaround Time = %.2f", avgTAT / n);

    return 0;
}

