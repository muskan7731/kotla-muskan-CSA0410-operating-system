#include <stdio.h>
#include <sys/ipc.h>
#include <sys/shm.h>
#include <string.h>

int main()
{
    key_t key = 1234;
    int shmid;
    char *data;

    // Create shared memory
    shmid = shmget(key, 1024, 0666 | IPC_CREAT);

    // Attach shared memory
    data = (char *)shmat(shmid, NULL, 0);

    printf("Enter a message: ");
    scanf(" %[^\n]", data);

    printf("\nMessage written to shared memory: %s\n", data);

    // Detach shared memory
    shmdt(data);

    return 0;
}
