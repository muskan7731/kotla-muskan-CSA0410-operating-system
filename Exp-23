#include <stdio.h>

int main()
{
    int block[5]={100,500,200,300,600};
    int process[4]={212,417,112,426};

    int i,j;

    printf("Process\tBlock\n");

    for(i=0;i<4;i++)
    {
        for(j=0;j<5;j++)
        {
            if(block[j]>=process[i])
            {
                printf("%d\t%d\n",process[i],j+1);
                block[j]-=process[i];
                break;
            }
        }

        if(j==5)
            printf("%d\tNot Allocated\n",process[i]);
    }

    return 0;
}
Process Block
212     2
417     5
112     2
426     Not Allocated
