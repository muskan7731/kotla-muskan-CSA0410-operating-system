#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <dirent.h>

int main()
{
    int fd;

    struct stat st;

    DIR *dir;

    struct dirent *entry;

    fd = open("sample.txt", O_RDONLY);

    lseek(fd, 0, SEEK_SET);

    fstat(fd, &st);

    printf("File Size = %ld bytes\n", st.st_size);

    close(fd);

    dir = opendir(".");

    printf("\nDirectory Contents\n");

    while((entry = readdir(dir)) != NULL)
        printf("%s\n", entry->d_name);

    closedir(dir);

    return 0;
}
